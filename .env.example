# Copy this file to a local .env only if you want Compose to load optional values.
# It is safe to omit this file. Never commit real credentials.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
HUGGINGFACE_API_KEY=
PINECONE_API_KEY=
COHERE_API_KEY=
REPLICATE_API_TOKEN=
LANGCHAIN_API_KEY=
LANGSMITH_API_KEY=
WANDB_API_KEY=
WANDB_PROJECT=ml-experiments

# Optional in-container service settings
CODE_SERVER_AUTH=none
JUPYTER_TOKEN=
MLFLOW_BACKEND_STORE_URI=sqlite:////workspace/mlflow.db

# Optional database credentials for local development
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ml_database
MONGO_USER=admin
MONGO_PASSWORD=admin
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=admin

# Optional host port overrides
CODE_SERVER_PORT=8080
JUPYTER_PORT=8888
