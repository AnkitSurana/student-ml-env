#!/bin/sh
set -eu

usage() {
    cat <<'EOF'
Usage: ml-env <command> [arguments]

Commands:
  code [path]       Start VS Code in the browser (port CODE_SERVER_PORT)
  jupyter           Start JupyterLab (port JUPYTER_PORT)
  tensorboard       Start TensorBoard (port TENSORBOARD_PORT)
  streamlit FILE    Start a Streamlit app (port STREAMLIT_PORT)
  mlflow            Start the MLflow tracking UI (port MLFLOW_PORT)
  service NAME      Configure, start, and validate one Compose service
  services          Choose a service interactively
  shell             Open a shell in the workspace
  python [args]     Run Python with the installed ML environment
  help              Show this help

Service configuration is saved in /workspace/.env. Values can be entered
interactively, or edited in that file and supplied on the next run.
EOF
}

ENV_FILE="${ML_ENV_FILE:-/workspace/.env}"

compose() {
    if command -v docker-compose >/dev/null 2>&1; then
        docker-compose --env-file "$ENV_FILE" -p "${COMPOSE_PROJECT_NAME:-student-ml-env}" -f /workspace/docker-compose.yml "$@"
    elif command -v docker >/dev/null 2>&1 && docker compose version >/dev/null 2>&1; then
        docker compose --env-file "$ENV_FILE" -p "${COMPOSE_PROJECT_NAME:-student-ml-env}" -f /workspace/docker-compose.yml "$@"
    else
        echo "Docker Compose is unavailable inside this container." >&2
        echo "Use the host command: docker compose up -d SERVICE" >&2
        exit 1
    fi
}

ensure_env_file() {
    if [ ! -f "$ENV_FILE" ]; then
        umask 077
        printf '# Generated by ml-env. Edit this file to change service settings.\n' > "$ENV_FILE"
    fi
}

env_value() {
    key="$1"
    current="$(printenv "$key" 2>/dev/null || true)"
    if [ -n "$current" ]; then
        printf '%s' "$current"
        return
    fi
    if [ -f "$ENV_FILE" ]; then
        value="$(sed -n "s/^${key}=//p" "$ENV_FILE" | tail -n 1)"
        [ -n "$value" ] && printf '%s' "$value"
    fi
}

ask_env() {
    key="$1"
    default="$2"
    current="$(env_value "$key")"
    [ -n "$current" ] && default="$current"
    printf '%s [%s] (type file to edit %s): ' "$key" "$default" "$ENV_FILE" >&2
    IFS= read -r value
    if [ "$value" = "file" ]; then
        printf '%s=\n' "$key" >> "$ENV_FILE"
        CONFIG_PENDING=1
        return
    fi
    [ -n "$value" ] || value="$default"
    printf '%s=%s\n' "$key" "$value" >> "$ENV_FILE"
}

configure_service() {
    service="$1"
    ensure_env_file
    case "$service" in
        postgres)
            ask_env POSTGRES_HOST postgres
            ask_env POSTGRES_PORT 5432
            ask_env POSTGRES_USER postgres
            ask_env POSTGRES_PASSWORD postgres
            ask_env POSTGRES_DB ml_database
            ;;
        mongodb)
            ask_env MONGO_USER admin
            ask_env MONGO_PASSWORD admin
            ask_env MONGO_PORT 27017
            ;;
        redis)
            ask_env REDIS_PORT 6379
            ;;
        chromadb)
            ask_env CHROMA_PORT 8000
            ;;
        qdrant)
            ask_env QDRANT_PORT 6333
            ;;
        weaviate)
            ask_env WEAVIATE_PORT 8080
            ;;
        milvus)
            ask_env MILVUS_PORT 19530
            ;;
        pgadmin)
            ask_env PGADMIN_EMAIL admin@example.com
            ask_env PGADMIN_PASSWORD admin
            ;;
        mongo-express)
            ask_env MONGO_USER admin
            ask_env MONGO_PASSWORD admin
            ;;
        *)
            echo "Unknown service: $service" >&2
            echo "Use: postgres mongodb redis chromadb qdrant weaviate milvus pgadmin mongo-express" >&2
            exit 2
            ;;
    esac
}

validate_service() {
    service="$1"
    host="$2"
    port="$3"
    printf 'Validating %s at %s:%s...\n' "$service" "$host" "$port" >&2
    i=1
    while [ "$i" -le 30 ]; do
        if python - "$host" "$port" <<'PY'
import socket
import sys

with socket.create_connection((sys.argv[1], int(sys.argv[2])), timeout=2):
    pass
PY
        then
            printf '%s is reachable.\n' "$service" >&2
            return 0
        fi
        sleep 2
        i=$((i + 1))
    done
    printf '%s is not reachable. Check %s and run `ml-env service %s` again.\n' \
        "$service" "$ENV_FILE" "$service" >&2
    return 1
}

start_service() {
    service="$1"
    CONFIG_PENDING=0
    configure_service "$service"
    if [ "$CONFIG_PENDING" -eq 1 ]; then
        printf 'Edit %s, then run `ml-env service %s` again.\n' "$ENV_FILE" "$service" >&2
        exit 2
    fi
    compose up -d "$service"
    case "$service" in
        postgres)
            host="$(env_value POSTGRES_HOST)"; [ -n "$host" ] || host=postgres
            validate_service postgres "$host" 5432
            ;;
        mongodb) validate_service mongodb mongodb 27017 ;;
        redis) validate_service redis redis 6379 ;;
        chromadb) validate_service chromadb chromadb 8000 ;;
        qdrant) validate_service qdrant qdrant 6333 ;;
        weaviate) validate_service weaviate weaviate 8080 ;;
        milvus) validate_service milvus milvus 19530 ;;
        pgadmin) validate_service pgadmin pgadmin 80 ;;
        mongo-express) validate_service mongo-express mongo-express 8081 ;;
    esac
}

choose_service() {
    printf '%s\n' \
        "1) postgres" "2) mongodb" "3) redis" "4) chromadb" \
        "5) qdrant" "6) weaviate" "7) milvus" "8) pgadmin" \
        "9) mongo-express"
    printf 'Choose a service number: '
    IFS= read -r choice
    case "$choice" in
        1) start_service postgres ;;
        2) start_service mongodb ;;
        3) start_service redis ;;
        4) start_service chromadb ;;
        5) start_service qdrant ;;
        6) start_service weaviate ;;
        7) start_service milvus ;;
        8) start_service pgadmin ;;
        9) start_service mongo-express ;;
        *) echo "Invalid service selection." >&2; exit 2 ;;
    esac
}

port_or_default() {
    value="$(printenv "$1" 2>/dev/null || true)"
    if [ -n "$value" ]; then
        printf '%s' "$value"
    else
        printf '%s' "$2"
    fi
}

case "${1:-help}" in
    code)
        shift
        exec code-server \
            --bind-addr "${CODE_SERVER_BIND_ADDR:-0.0.0.0:$(port_or_default CODE_SERVER_PORT 8080)}" \
            --auth "${CODE_SERVER_AUTH:-none}" \
            --disable-telemetry "${1:-/workspace}"
        ;;
    jupyter)
        shift
        exec jupyter lab \
            --ip="${JUPYTER_BIND_ADDR:-0.0.0.0}" \
            --port="$(port_or_default JUPYTER_PORT 8888)" \
            --no-browser \
            --allow-root \
            --ServerApp.token="${JUPYTER_TOKEN:-}" \
            "$@"
        ;;
    tensorboard)
        shift
        exec tensorboard \
            --host="${TENSORBOARD_BIND_ADDR:-0.0.0.0}" \
            --port="$(port_or_default TENSORBOARD_PORT 6006)" \
            --logdir="${TENSORBOARD_LOGDIR:-/workspace/logs}" \
            "$@"
        ;;
    streamlit)
        shift
        if [ "$#" -eq 0 ]; then
            echo "streamlit requires an application path, for example: ml-env streamlit app.py" >&2
            exit 2
        fi
        app="$1"
        shift
        exec streamlit run "$app" \
            --server.address="${STREAMLIT_BIND_ADDR:-0.0.0.0}" \
            --server.port="$(port_or_default STREAMLIT_PORT 8501)" \
            "$@"
        ;;
    mlflow)
        shift
        exec mlflow ui \
            --host="${MLFLOW_BIND_ADDR:-0.0.0.0}" \
            --port="$(port_or_default MLFLOW_PORT 5000)" \
            --backend-store-uri="${MLFLOW_BACKEND_STORE_URI:-sqlite:////workspace/mlflow.db}" \
            "$@"
        ;;
    service)
        [ "$#" -eq 2 ] || { echo "Usage: ml-env service NAME" >&2; exit 2; }
        start_service "$2"
        ;;
    services)
        choose_service
        ;;
    shell)
        exec /bin/sh
        ;;
    python)
        shift
        exec python "$@"
        ;;
    help|-h|--help)
        usage
        ;;
    *)
        echo "Unknown command: $1" >&2
        usage >&2
        exit 2
        ;;
esac
