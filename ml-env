#!/bin/sh
set -eu

usage() {
    cat <<'EOF'
Usage: ./ml-env <command> [arguments]

Run from the repository checkout. Service commands prompt for configuration,
write .env, start the selected Compose service, and validate connectivity.

Commands:
  service NAME   Configure and start one service
  services       Choose a service interactively
  start          Start the complete Compose environment
  stop           Stop the complete Compose environment
  status         Show service status
  logs [SERVICE] Follow logs
EOF
}

case "${1:-help}" in
    service|services)
        exec docker compose exec -it ml-ide ml-env "$@"
        ;;
    start)
        exec docker compose up -d
        ;;
    stop)
        exec docker compose down
        ;;
    status)
        exec docker compose ps
        ;;
    logs)
        shift
        exec docker compose logs -f "$@"
        ;;
    help|-h|--help)
        usage
        ;;
    *)
        echo "Unknown command: $1" >&2
        usage >&2
        exit 2
        ;;
esac
